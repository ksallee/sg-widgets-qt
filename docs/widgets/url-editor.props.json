{
  "name": "url-editor",
  "page": "url-editor",
  "declares": null,
  "props": [
    {
      "name": "value",
      "type": "`UrlValue | null`",
      "py_type": "`Optional[UrlValue]`",
      "default": "`null`",
      "meaning": "The stored object. Two-way in Svelte."
    },
    {
      "name": "on_value_change",
      "type": "`(value: UrlWriteValue | null) => void`",
      "py_type": "`Callable[[Optional[UrlWriteValue]], None]`",
      "default": "—",
      "meaning": "Called when either input commits."
    },
    {
      "name": "field",
      "type": "`FieldSchema | null`",
      "py_type": "`Optional[FieldSchema]`",
      "default": "`null`",
      "meaning": "Supplies the accessible label and the required flag."
    },
    {
      "name": "disabled",
      "type": "`boolean`",
      "py_type": "`bool`",
      "default": "`false`"
    },
    {
      "name": "readonly",
      "type": "`boolean`",
      "py_type": "`bool`",
      "default": "`false`"
    },
    {
      "name": "invalid",
      "type": "`boolean`",
      "py_type": "`bool`",
      "default": "`false`",
      "meaning": "Forced invalid state."
    },
    {
      "name": "error",
      "type": "`string | null`",
      "py_type": "`Optional[str]`",
      "default": "`null`",
      "meaning": "A message from the caller, shown in place of the parse error."
    },
    {
      "name": "on_error_change",
      "type": "`(error: string | null) => void`",
      "py_type": "`Callable[[Optional[str]], None]`",
      "default": "—",
      "meaning": "Called when the parse error appears or clears."
    },
    {
      "name": "placeholder",
      "type": "`string`",
      "py_type": "`str`",
      "default": "an example address",
      "meaning": "Placeholder of the address input."
    },
    {
      "name": "name_placeholder",
      "type": "`string`",
      "py_type": "`str`",
      "default": "`'Name'`",
      "meaning": "Placeholder of the name input."
    },
    {
      "name": "error_message",
      "type": "`(message: string) => ReactNode` / `Snippet<[string]>`",
      "py_type": "`Callable[[str], ReactNode]` / `Snippet[tuple[str]]`",
      "default": "—",
      "meaning": "Renders the message. Default is a small destructive line under the control.",
      "owner": "value-editor"
    },
    {
      "name": "size",
      "type": "`'sm' | 'md' | 'lg'`",
      "py_type": "`Literal['sm', 'md', 'lg']`",
      "default": "`'md'`",
      "meaning": "Control height.",
      "owner": "value-editor"
    }
  ],
  "events": [],
  "slots": [],
  "keyboard": [
    {
      "key": "`Enter`",
      "does": "Commits both inputs."
    },
    {
      "key": "`Escape`",
      "does": "Restores the stored value."
    },
    {
      "key": "`Tab`",
      "does": "Moves between address and name."
    }
  ]
}
